---
import '../styles/global.css';
import Icon from '../components/Icon.astro';

interface Props {
  title?: string;
  description?: string;
  /** 详情页等可传具体 URL，用于 OG / canonical */
  ogImage?: string;
}

const {
  title = '手游测评站',
  description = '主推《桃园将帅录》《小小屠龙》的手游测评与攻略站：真实、克制、结论先行，图片与资料整理自官方公开渠道。',
  ogImage,
} = Astro.props;

const siteName = '手游测评站';
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImg = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
// base 感知：项目页下内部链接需带 /<repo>/ 前缀
const BASE = import.meta.env.BASE_URL;
const sitemapUrl = (Astro.site ?? new URL(BASE, 'https://example.github.io')).href.replace(/\/$/, '') + '/sitemap-index.xml';
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImg && <meta property="og:image" content={ogImg} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImg && <meta name="twitter:image" content={ogImg} />}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: (Astro.site ?? Astro.url).href,
    })} />

    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">跳到主内容</a>

    <header class="site-header">
      <div class="container">
        <a class="brand" href={BASE}><Icon name="gamepad" size={22} /> <span>游戏测评站</span></a>
        <nav class="nav" aria-label="主导航">
          <a href={BASE}>首页</a>
          <a href={`${BASE}#spotlight`}>本期主推</a>
          <a href={`${BASE}library`}>全部游戏</a>
          <a href={`${BASE}guides`}>攻略</a>
        </nav>
        <form class="nav-search" action={`${BASE}library`} method="get" role="search">
          <Icon name="search" size={16} class="ic" />
          <input type="search" name="kw" placeholder="搜索游戏…" aria-label="搜索游戏" autocomplete="off" />
        </form>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 游戏测评站 · 精选好游戏，真实、克制、结论先行 · <a href={BASE}>回到首页</a> · <a href={`${BASE}#service`}>联系客服</a></p>
        <p>本站为独立测评介绍站，非游戏官方站点。内容与图片整理自各游戏官方公开渠道，图片版权归原运营方所有；本站未做实测，评分均标注「待定」，版本与收费信息以官方公告为准。</p>
        <p class="footer-note">客服二维码为本站提供的公众号入口，扫码后请按公众号指引咨询；本站不代收任何费用，也不处理充值与账号问题。</p>
        <p class="footer-sources">图片来源：桃园将帅录官网 · 小小屠龙官网 · 老炮怀旧手游平台（版权归原运营方所有）</p>
        <p class="footer-note">竖版海报由本站官方宣传图二次排版生成（模糊背景 + 原图），非游戏官方原图。</p>
      </div>
    </footer>

    <button class="fab" id="fab" type="button" aria-label="联系客服"><Icon name="chat" size={18} /> 联系客服</button>
    <button class="to-top" id="toTop" type="button" aria-label="回到顶部"><Icon name="arrow-up" size={22} /></button>
    <div class="toast" id="toast" role="status" aria-live="polite"><Icon name="info" size={18} /><span id="toastText"></span></div>

    <script define:vars={{ base: BASE }}>
      const toast = document.getElementById('toast');
      const toastText = document.getElementById('toastText');
      let toastTimer;
      function showToast(msg) {
        if (!toast || !toastText) return;
        toastText.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 1900);
      }
      window.showToast = showToast;
      document.addEventListener('toast', (e) => showToast(e.detail));

      const fab = document.getElementById('fab');
      const toTop = document.getElementById('toTop');
      function onScroll() {
        const y = window.scrollY;
        fab?.classList.toggle('show', y > 300);
        toTop?.classList.toggle('show', y > 400);
      }
      window.addEventListener('scroll', onScroll, { passive: true });
      onScroll();

      toTop?.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
      fab?.addEventListener('click', () => {
        const target = document.getElementById('service');
        if (target) {
          window.scrollTo({ top: target.getBoundingClientRect().top + window.scrollY - 84, behavior: 'smooth' });
        } else {
          window.location.href = base + '#service';
        }
      });

      // 客服二维码放大弹窗（Esc / 遮罩关闭、焦点回归）
      // 注意：define:vars 的内联脚本不会被 TypeScript 编译，此处只能写纯 JS
      const qrModal = document.querySelector('[data-qr-modal]');
      let qrPrevFocus = null;
      const openQr = () => {
        if (!qrModal) return;
        qrPrevFocus = document.activeElement;
        qrModal.classList.add('open');
        document.body.style.overflow = 'hidden';
        qrModal.querySelector('[data-qr-close]')?.focus();
      };
      const closeQr = () => {
        if (!qrModal) return;
        qrModal.classList.remove('open');
        document.body.style.overflow = '';
        qrPrevFocus?.focus();
      };
      document.querySelectorAll('[data-qr-open]').forEach((btn) => btn.addEventListener('click', openQr));
      qrModal?.querySelector('[data-qr-close]')?.addEventListener('click', closeQr);
      qrModal?.addEventListener('click', (e) => { if (e.target === qrModal) closeQr(); });
      document.addEventListener('keydown', (e) => {
        if (e.key === 'Escape' && qrModal?.classList.contains('open')) closeQr();
      });

      // 锚点跳转补偿固定导航高度（#official 为旧锚点，兼容映射到客服区）
      const hash = window.location.hash === '#official' ? '#service' : window.location.hash;
      if (hash) {
        const el = document.querySelector(hash);
        if (el) setTimeout(() => window.scrollTo({ top: el.getBoundingClientRect().top + window.scrollY - 84, behavior: 'smooth' }), 120);
      }
    </script>
  </body>
</html>
