---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Icon from '../components/Icon.astro';
import IconSprite from '../components/IconSprite.astro';

interface Props {
  title?: string;
  description?: string;
  /** 详情页等可传具体 URL，用于 OG / canonical */
  ogImage?: string;
  /** 首屏 LCP 图片：提前 preload，避免等 CSS 解析后才发起请求 */
  preloadImage?: string;
}

// 站点名称：全站唯一数据源，标签页标题 / OG / JSON-LD / 导航品牌 / 页脚都引用它
const SITE_NAME = '游戏测评站';

const {
  title = SITE_NAME,
  description = '主推《桃园将帅录》《小小屠龙》的游戏测评与攻略站：真实、克制、结论先行，图片与资料整理自官方公开渠道。',
  ogImage,
  preloadImage,
} = Astro.props;

const siteName = SITE_NAME;
const fullTitle = title === siteName ? title : `${title} · ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url).href;
const ogImg = ogImage ? new URL(ogImage, Astro.site ?? Astro.url).href : undefined;
// base 感知：项目页下内部链接需带 /<repo>/ 前缀
const BASE = import.meta.env.BASE_URL;
const sitemapUrl = (Astro.site ?? new URL(BASE, 'https://example.github.io')).href.replace(/\/$/, '') + '/sitemap-index.xml';
---

<!doctype html>
<html lang="zh-CN" data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#0a0a0f" />
    <link rel="icon" type="image/svg+xml" href={`${BASE}favicon.svg`} />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="sitemap" type="application/xml" title="Sitemap" href={sitemapUrl} />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    {ogImg && <meta property="og:image" content={ogImg} />}

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    {ogImg && <meta name="twitter:image" content={ogImg} />}

    <script type="application/ld+json" set:html={JSON.stringify({
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: siteName,
      url: (Astro.site ?? Astro.url).href,
    })} />

    {/* Hero 是 CSS 背景图，浏览器要等 CSS + DOM 解析完才发现它；显式 preload 让它与 CSS 并行下载 */}
    {preloadImage && <link rel="preload" as="image" href={preloadImage} fetchpriority="high" />}

    {/* 站内点击只替换 body，不再整页刷新；配合 prefetch 的预取缓存做到近乎瞬时切页 */}
    <ClientRouter />

    <slot name="head" />
  </head>
  <body>
    <IconSprite />
    <a class="skip-link" href="#main">跳到主内容</a>

    <header class="site-header">
      <div class="container">
        <a class="brand" href={BASE}><Icon name="gamepad" size={22} /> <span>{siteName}</span></a>
        <nav class="nav" aria-label="主导航">
          <a href={BASE}>首页</a>
          <a href={`${BASE}#spotlight`} data-astro-prefetch="false">本期主推</a>
          <a href={`${BASE}library`}>全部游戏</a>
          <a href={`${BASE}guides`}>攻略</a>
        </nav>
        <form class="nav-search" action={`${BASE}library`} method="get" role="search">
          <Icon name="search" size={16} class="ic" />
          <input type="search" name="kw" placeholder="搜索游戏…" aria-label="搜索游戏" autocomplete="off" />
        </form>
      </div>
    </header>

    <main id="main">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container">
        <p>© 2026 {siteName} · 精选好游戏，真实、克制、结论先行 · <a href={BASE}>回到首页</a> · <a href={`${BASE}#service`} data-astro-prefetch="false">联系客服</a></p>
        <p>本站为独立测评介绍站，非游戏官方站点。内容与图片整理自各游戏官方公开渠道，图片版权归原运营方所有；本站未做实测，评分均标注「待定」，版本与收费信息以官方公告为准。</p>
        <p class="footer-note">客服二维码为本站提供的公众号入口，扫码后请按公众号指引咨询；本站不代收任何费用，也不处理充值与账号问题。</p>
        <p class="footer-sources">图片来源：桃园将帅录官网 · 小小屠龙官网 · 老炮怀旧手游平台（版权归原运营方所有）</p>
        <p class="footer-note">竖版海报由本站官方宣传图二次排版生成（模糊背景 + 原图），非游戏官方原图。</p>
      </div>
    </footer>

    <button class="fab" id="fab" type="button" aria-label="联系客服"><Icon name="chat" size={18} /> 联系客服</button>
    <button class="to-top" id="toTop" type="button" aria-label="回到顶部"><Icon name="arrow-up" size={22} /></button>
    <div class="toast" id="toast" role="status" aria-live="polite"><Icon name="info" size={18} /><span id="toastText"></span></div>

    <script>
      import { navigate } from 'astro:transitions/client';

      // ClientRouter 下 bundle 脚本只执行一次：所有初始化必须挂到 astro:page-load，
      // 元素级事件在每次 body 替换后重新绑定；document / window 级监听只注册一次，
      // 内部一律动态查询当前 DOM，避免监听器随导航累积。
      const BASE = document.documentElement.dataset.base || '/';

      let toastTimer;
      let scrollQueued = false, fabShown = false, topShown = false;
      let qrPrevFocus = null;
      let globalsBound = false;

      function showToast(msg) {
        const toast = document.getElementById('toast');
        const text = document.getElementById('toastText');
        if (!toast || !text) return;
        text.textContent = msg;
        toast.classList.add('show');
        clearTimeout(toastTimer);
        toastTimer = setTimeout(() => toast.classList.remove('show'), 1900);
      }

      // 滚动用 rAF 节流，且只在显隐状态翻转时写 DOM
      function readScroll() {
        scrollQueued = false;
        const y = window.scrollY;
        const showFab = y > 300, showTop = y > 400;
        if (showFab !== fabShown) { fabShown = showFab; document.getElementById('fab')?.classList.toggle('show', showFab); }
        if (showTop !== topShown) { topShown = showTop; document.getElementById('toTop')?.classList.toggle('show', showTop); }
      }
      function onScroll() {
        if (scrollQueued) return;
        scrollQueued = true;
        requestAnimationFrame(readScroll);
      }
      // 长距离平滑滚动要 1s 以上，体感像「点了没反应」；超过阈值改为瞬时
      function jumpTo(top) {
        const behavior = Math.abs(top - window.scrollY) > 1400 ? 'instant' : 'smooth';
        window.scrollTo({ top, behavior });
      }

      function openQr() {
        const modal = document.querySelector('[data-qr-modal]');
        if (!modal) return;
        qrPrevFocus = document.activeElement;
        modal.classList.add('open');
        document.body.style.overflow = 'hidden';
        modal.querySelector('[data-qr-close]')?.focus();
      }
      function closeQr() {
        const modal = document.querySelector('[data-qr-modal].open');
        if (!modal) return;
        modal.classList.remove('open');
        document.body.style.overflow = '';
        if (qrPrevFocus && qrPrevFocus.isConnected) qrPrevFocus.focus();
        qrPrevFocus = null;
      }

      function initPage() {
        if (!globalsBound) {
          globalsBound = true;
          window.showToast = showToast;
          document.addEventListener('toast', (e) => showToast(e.detail));
          window.addEventListener('scroll', onScroll, { passive: true });
          document.addEventListener('keydown', (e) => { if (e.key === 'Escape') closeQr(); });
        }

        // 顶部搜索：有海报墙的页面同页即时筛选；其它页面用 router 无刷新跳到游戏库
        const navSearch = document.querySelector('.nav-search');
        navSearch?.addEventListener('submit', (e) => {
          e.preventDefault();
          const kw = (navSearch.querySelector('input')?.value ?? '').trim();
          const gridSearch = document.querySelector('[data-search]');
          if (!gridSearch) {
            navigate(`${BASE}library${kw ? `?kw=${encodeURIComponent(kw)}` : ''}`);
            return;
          }
          gridSearch.value = kw;
          gridSearch.dispatchEvent(new Event('input', { bubbles: true }));
          const url = new URL(window.location.href);
          if (kw) url.searchParams.set('kw', kw); else url.searchParams.delete('kw');
          history.replaceState(null, '', url);
          const anchor = document.getElementById('games') ?? gridSearch.closest('[data-poster-section]');
          if (anchor) jumpTo(anchor.getBoundingClientRect().top + window.scrollY - 84);
        });

        document.getElementById('toTop')?.addEventListener('click', () => jumpTo(0));
        document.getElementById('fab')?.addEventListener('click', () => {
          const target = document.getElementById('service');
          if (target) jumpTo(target.getBoundingClientRect().top + window.scrollY - 84);
          else window.location.href = BASE + '#service';
        });

        // 客服二维码放大弹窗（Esc / 遮罩关闭、焦点回归）
        document.querySelectorAll('[data-qr-open]').forEach((btn) => btn.addEventListener('click', openQr));
        const qrModal = document.querySelector('[data-qr-modal]');
        qrModal?.querySelector('[data-qr-close]')?.addEventListener('click', closeQr);
        qrModal?.addEventListener('click', (e) => { if (e.target === qrModal) closeQr(); });

        // 锚点跳转补偿固定导航高度（#official 为旧锚点，兼容映射到客服区）
        const hash = window.location.hash === '#official' ? '#service' : window.location.hash;
        if (hash) {
          const el = document.getElementById(hash.slice(1));
          if (el) requestAnimationFrame(() => window.scrollTo({
            top: el.getBoundingClientRect().top + window.scrollY - 84,
            behavior: 'instant',
          }));
        }
        readScroll();
      }

      document.addEventListener('astro:page-load', initPage);
    </script>
  </body>
</html>
