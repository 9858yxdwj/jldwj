---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ServiceCard from '../../components/ServiceCard.astro';
import { games } from '../../data/games';
import { asset } from '../../utils/asset';

export function getStaticPaths() {
  return games.map((g) => ({ params: { slug: g.slug }, props: { game: g } }));
}

const { game } = Astro.props;
const ratingText = game.rating === null ? '待定' : game.rating.toFixed(1);
const BASE = import.meta.env.BASE_URL;
const hasGallery = Array.isArray(game.screenshots) && game.screenshots.length > 0;
const poster = game.poster ?? asset(`/images/posters/${game.slug}.webp`);
const pageUrl = new URL(`${BASE}games/${game.slug}`, Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'VideoGame',
  name: game.title,
  description: game.description,
  genre: game.category,
  url: pageUrl,
  image: new URL(game.cover, Astro.site ?? Astro.url).href,
  offers: { '@type': 'Offer', price: game.price, availability: 'https://schema.org/InStock' },
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL(BASE, Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 2, name: '游戏库', item: new URL(`${BASE}library`, Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 3, name: game.title, item: pageUrl },
  ],
};
---

<BaseLayout title={game.title} description={game.description} ogImage={game.cover}>
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="container inner-page">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={BASE}>首页</a> / <a href={`${BASE}library`}>游戏库</a> / <span>{game.title}</span>
    </nav>

    <article class="detail">
      <div class="detail-cover">
        <img src={poster} alt={`${game.title} 竖版海报`} decoding="async" fetchpriority="high" width="600" height="800" />
      </div>

      <div class="detail-info">
        <img class="detail-banner" src={game.cover} alt={`${game.title} 官方宣传图`} decoding="async" width="800" height="450" />
        <h1>{game.title}</h1>
        <div class="card-meta">
          <span>{game.category}</span>
          <span class="rating">★ {ratingText}</span>
          <span>{game.status}</span>
        </div>

        <div class="price-row">
          <span class="price">{game.price}</span>
          {game.originalPrice && <span class="price-old">{game.originalPrice}</span>}
        </div>

        <div class="kv"><span class="k">平台</span><span class="v">{game.platform.join(' / ')}</span></div>
        <div class="kv"><span class="k">标签</span><span class="v">{game.tags.join('、')}</span></div>
        <div class="kv"><span class="k">简介</span><span class="v">{game.description}</span></div>

        {game.developer && (
          <div class="detail-dev">
            信息来源：{game.developer}{game.releaseDate ? ` · 上线：${game.releaseDate}` : ''}
          </div>
        )}
        <p class="detail-note">本站未对游戏做实测，评分显示「待定」；平台、收费与版本内容均以官方公告为准。</p>

        {hasGallery && (
          <div class="gallery">
            {game.screenshots.map((s) => (
              <img src={s} alt={`${game.title} 官方游戏截图`} loading="lazy" decoding="async" fetchpriority="low" width="720" height="405" />
            ))}
          </div>
        )}
      </div>
    </article>

    <ServiceCard />
  </div>
</BaseLayout>
