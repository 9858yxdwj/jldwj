---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSpotlight from '../components/FeaturedSpotlight.astro';
import HotScroll from '../components/HotScroll.astro';
import PosterGrid from '../components/PosterGrid.astro';
import GuideCard from '../components/GuideCard.astro';
import ContactCard from '../components/ContactCard.astro';
import Icon from '../components/Icon.astro';
import { games, CATEGORY_LIST, featuredGames } from '../data/games';
import { getCollection } from 'astro:content';

const total = games.length;
const guides = (await getCollection('guides')).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const guideCount = guides.length;
const catCount = CATEGORY_LIST.length;
const BASE = import.meta.env.BASE_URL;
const heroImage = featuredGames[0]?.hero;
---

<BaseLayout preloadImage={heroImage}>
  <!-- 沉浸式 Hero：模糊放大的官方 banner + 渐变遮罩 -->
  <section class="hero-wall" id="home">
    <div class="hero-bg" style={heroImage ? `background-image:url('${heroImage}')` : undefined}></div>
    <div class="hero-content">
      <div class="hero-tag"><Icon name="sparkles" size={14} /> 真实测评 · 精选好游戏</div>
      <h1>发现你的<br /><em>下一款最爱游戏</em></h1>
      <p>
        收录 {total} 款手游与 {guideCount} 篇实战攻略，本期主推《桃园将帅录》与《小小屠龙》。
        内容与图片整理自官方公开渠道，未实测信息均明确标注，评分一律「待定」。
      </p>

      <div class="hero-stats">
        <div class="stat"><div class="num">{total}</div><div class="lbl">款精选游戏</div></div>
        <div class="stat"><div class="num">{guideCount}</div><div class="lbl">篇实战攻略</div></div>
        <div class="stat"><div class="num">{catCount}</div><div class="lbl">个游戏分类</div></div>
        <div class="stat"><div class="num">{featuredGames.length}</div><div class="lbl">款本期主推</div></div>
      </div>

      <div class="hero-cta">
        <a class="btn-primary" href="#games" data-astro-prefetch="false"><Icon name="grid" size={18} /> 浏览全部游戏</a>
        <a class="btn-ghost" href="#spotlight" data-astro-prefetch="false"><Icon name="sparkles" size={18} /> 查看本期主推</a>
      </div>
    </div>
  </section>

  <FeaturedSpotlight />

  <HotScroll />

  <PosterGrid
    games={games}
    id="games"
    title="🎯 全部游戏"
    badge="ALL"
    sub="点击卡片查看详情，或点「快速预览」先看个大概"
  />

  <div class="section-title" id="guides">
    <h2>📖 最新攻略</h2>
    <span class="badge">GUIDE</span>
    <a class="more" href={`${BASE}guides`}>查看全部攻略 <Icon name="arrow-right" size={15} /></a>
  </div>
  <div class="poster-grid">
    {guides.slice(0, 3).map((g) => <GuideCard guide={g} />)}
  </div>

  <ContactCard />
</BaseLayout>
