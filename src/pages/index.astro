---
import BaseLayout from '../layouts/BaseLayout.astro';
import FeaturedSpotlight from '../components/FeaturedSpotlight.astro';
import FeaturedGrid from '../components/FeaturedGrid.astro';
import GuideCard from '../components/GuideCard.astro';
import OfficialChannels from '../components/OfficialChannels.astro';
import { games, CATEGORY_LIST, featuredGames } from '../data/games';
import { getCollection } from 'astro:content';

const total = games.length;
const guides = await getCollection('guides');
const guideCount = guides.length;
const catCount = CATEGORY_LIST.length;

const catCounts = CATEGORY_LIST.map((c) => ({
  name: c,
  count: games.filter((g) => g.category === c).length,
}));
const BASE = import.meta.env.BASE_URL;
const heroImage = featuredGames[0]?.hero;
---

<BaseLayout>
  <section class="hero hero-featured" style={heroImage ? `background-image:url('${heroImage}')` : undefined}>
    <div class="container">
      <span class="hero-eyebrow">手游测评 · 攻略站</span>
      <h1>真实、克制、结论先行的手游测评</h1>
      <p>收录 {total} 款手游与 {guideCount} 篇实战攻略。本期主推《桃园将帅录》与《小小屠龙》。内容整理自官方公开资料，未实测信息均明确标注。</p>

      <div class="hero-stats">
        <div class="stat"><strong>{total}</strong><span>收录游戏</span></div>
        <div class="stat"><strong>{guideCount}</strong><span>攻略文章</span></div>
        <div class="stat"><strong>{catCount}</strong><span>游戏分类</span></div>
      </div>

      <div class="cat-chips" aria-label="按分类浏览">
        {catCounts.map((c) => (
          <a class="cat-chip" href={`${BASE}library?cat=${encodeURIComponent(c.name)}`}>
            {c.name}<span class="count">{c.count}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <FeaturedSpotlight />

  <FeaturedGrid limit={3} />

  <section class="section">
    <div class="container">
      <div class="section-head">
        <h2>最新攻略</h2>
        <a href={`${BASE}guides`}>查看全部 →</a>
      </div>
      <div class="grid">
        {(guides.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())).slice(0, 3).map((g) => <GuideCard guide={g} />)}
      </div>
    </div>
  </section>

  <OfficialChannels />
</BaseLayout>
