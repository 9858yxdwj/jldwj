---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { games } from '../../data/games';

export async function getStaticPaths() {
  const guides = await getCollection('guides');
  return guides.map((entry) => ({
    params: { slug: entry.slug },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await entry.render();
const { title, summary, gameSlug, category, tags, author, date, cover } = entry.data;
const BASE = import.meta.env.BASE_URL;
const relatedGame = gameSlug ? games.find((g) => g.slug === gameSlug) : undefined;
const fmtDate = date.toISOString().slice(0, 10);
const pageUrl = new URL(`${BASE}guides/${entry.slug}`, Astro.site ?? Astro.url).href;

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description: summary,
  datePublished: date.toISOString(),
  author: { '@type': 'Organization', name: author },
  image: cover ? new URL(cover, Astro.site ?? Astro.url).href : undefined,
  mainEntityOfPage: pageUrl,
};
const breadcrumbLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: '首页', item: new URL(BASE, Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 2, name: '攻略库', item: new URL(`${BASE}guides`, Astro.site ?? Astro.url).href },
    { '@type': 'ListItem', position: 3, name: title, item: pageUrl },
  ],
};
---

<BaseLayout title={title} description={summary} ogImage={cover}>
  <meta slot="head" property="article:published_time" content={date.toISOString()} />
  <meta slot="head" property="article:section" content={category} />
  <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  <script type="application/ld+json" set:html={JSON.stringify(breadcrumbLd)} />

  <div class="container">
    <nav class="breadcrumb" aria-label="面包屑">
      <a href={BASE}>首页</a> / <a href={`${BASE}guides`}>攻略库</a> / <span>{title}</span>
    </nav>

    <article class="section" style="padding-top:0;">
      <header style="max-width:760px;margin:0 auto;">
        {category && <span class="badge">{category}</span>}
        <h1 style="font-size:28px;margin:var(--sp-3) 0;">{title}</h1>
        <div class="card-meta" style="margin-bottom:var(--sp-4);">
          <span>{author}</span><span>·</span><span>{fmtDate}</span>
        </div>
      </header>

      <div class="prose" style="max-width:760px;margin:0 auto;">
        <p style="color:var(--c-text-muted);font-size:16px;">{summary}</p>
        <Content />
      </div>

      {tags.length > 0 && (
        <div class="tags" style="max-width:760px;margin:var(--sp-5) auto 0;">
          {tags.map((t) => <span class="tag">{t}</span>)}
        </div>
      )}

      {relatedGame && (
        <div style="max-width:760px;margin:var(--sp-6) auto 0;">
          <a class="btn-download" href={`${BASE}games/${relatedGame.slug}`}>查看关联游戏：{relatedGame.title} →</a>
        </div>
      )}
    </article>
  </div>
</BaseLayout>
