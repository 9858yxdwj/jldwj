---
import BaseLayout from '../layouts/BaseLayout.astro';
const BASE = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在" description="您访问的页面不存在或已被移动。">
  <section class="section inner-page" style="text-align:center;padding:80px 0 100px;">
    <div class="container">
      <div class="grad-text" style="font-size:clamp(80px,14vw,140px);font-weight:800;line-height:1;">404</div>
      <h1 style="margin:var(--sp-4) 0 var(--sp-3);font-size:26px;font-weight:800;">页面走丢了</h1>
      <p style="color:var(--muted);margin-bottom:var(--sp-5);">
        您要找的页面不存在，或已被移动。试试下面的入口：
      </p>
      <div style="display:flex;gap:12px;justify-content:center;flex-wrap:wrap;">
        <a class="btn-primary" style="flex:0 0 auto;padding:12px 24px;" href={BASE}>返回首页</a>
        <a class="btn-ghost" href={`${BASE}library`}>逛游戏库</a>
        <a class="btn-ghost" href={`${BASE}guides`}>看攻略</a>
      </div>
    </div>
  </section>
</BaseLayout>
