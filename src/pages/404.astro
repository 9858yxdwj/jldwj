---
import BaseLayout from '../layouts/BaseLayout.astro';
import Icon from '../components/Icon.astro';
const BASE = import.meta.env.BASE_URL;
---

<BaseLayout title="页面不存在" description="您访问的页面不存在或已被移动。">
  <section class="section inner-page notfound">
    <div class="container">
      <div class="notfound-code grad-text">404</div>
      <h1>页面走丢了</h1>
      <p>您要找的页面不存在，或已被移动。试试下面的入口：</p>
      <div class="notfound-actions">
        <a class="btn-primary" href={BASE}><Icon name="home" size={18} /> 返回首页</a>
        <a class="btn-ghost" href={`${BASE}library`}><Icon name="grid" size={18} /> 逛游戏库</a>
        <a class="btn-ghost" href={`${BASE}guides`}><Icon name="book" size={18} /> 看攻略</a>
      </div>
    </div>
  </section>
</BaseLayout>
