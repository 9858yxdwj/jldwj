---
// 本期主推：用官方 banner 大图突出展示重点游戏
import { featuredGames } from '../data/games';

const BASE = import.meta.env.BASE_URL;
---

<section class="section spotlight" aria-labelledby="spotlight-title">
  <div class="container">
    <div class="section-head">
      <div>
        <span class="eyebrow">本期主推</span>
        <h2 id="spotlight-title">重点推荐的两款手游</h2>
        <p class="section-sub">结论先行：一款主打三国策略博弈，一款主打复古打宝与自由交易。</p>
      </div>
      <a href={`${BASE}library`}>浏览全部游戏 →</a>
    </div>

    <div class="spotlight-grid">
      {featuredGames.map((g) => (
        <article class="spotlight-card">
          {g.hero && (
            <img class="spotlight-bg" src={g.hero} alt="" aria-hidden="true" width="1600" height="900" loading="lazy" decoding="async" />
          )}
          <div class="spotlight-shade" aria-hidden="true"></div>
          <div class="spotlight-content">
            <div class="spotlight-top">
              {g.icon && <img class="spotlight-icon" src={g.icon} alt="" aria-hidden="true" width="56" height="56" loading="lazy" />}
              <span class="badge badge-pick">主推</span>
              <span class="spotlight-cat">{g.category}</span>
            </div>
            <h3>{g.title}</h3>
            <p class="spotlight-desc">{g.description}</p>
            <div class="tags">
              {g.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
            </div>
            <div class="spotlight-actions">
              <a class="btn-spotlight" href={`${BASE}games/${g.slug}`}>查看测评 →</a>
              <a class="btn-spotlight ghost" href={g.externalUrl} target="_blank" rel="noopener noreferrer">前往官网 ↗</a>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>
</section>
