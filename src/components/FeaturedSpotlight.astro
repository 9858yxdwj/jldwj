---
// 本期主推：官方 banner 大图 + 渐变遮罩，突出桃园将帅录 / 小小屠龙
import { featuredGames } from '../data/games';
import Icon from './Icon.astro';

const BASE = import.meta.env.BASE_URL;
---

<div class="section-title" id="spotlight">
  <h2>✨ 本期主推</h2>
  <span class="badge">PICK</span>
  <span class="sub">结论先行：一款主打三国策略博弈，一款主打复古打宝与自由交易</span>
</div>

<div class="spotlight-grid">
  {featuredGames.map((g, i) => (
    <article class="spotlight-card">
      {g.hero && (
        <img class="spotlight-bg" src={g.hero} alt="" aria-hidden="true" width="1600" height="900"
          loading={i === 0 ? 'eager' : 'lazy'} fetchpriority={i === 0 ? 'high' : 'low'} decoding="async" />
      )}
      <div class="spotlight-shade" aria-hidden="true"></div>
      <div class="spotlight-content">
        <div class="spotlight-top">
          {g.icon && <img class="spotlight-icon" src={g.icon} alt="" aria-hidden="true" width="56" height="56" loading={i === 0 ? 'eager' : 'lazy'} decoding="async" />}
          <span class="badge badge-pick">主推</span>
          <span class="spotlight-cat">{g.category}</span>
        </div>
        <h3>{g.title}</h3>
        <p class="spotlight-desc">{g.description}</p>
        <div class="tags">
          {g.tags.slice(0, 4).map((t) => <span class="tag">{t}</span>)}
        </div>
        <div class="spotlight-actions">
          <a class="btn-spotlight" href={`${BASE}games/${g.slug}`}>查看测评 <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </article>
  ))}
</div>
