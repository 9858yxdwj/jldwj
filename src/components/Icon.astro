---
/**
 * 统一线性图标：单色、跟随 currentColor，避免 emoji 在不同系统/字体下渲染不一致。
 * 用于按钮与功能性图标；标题、空状态等装饰性 emoji 保留原来的视觉活力。
 * 用法：<Icon name="search" size={16} />
 */
const shapes = {
  search: '<circle cx="10.8" cy="10.8" r="6.8"/><path d="M16 16l4.2 4.2"/>',
  'zoom-in': '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/><path d="M10.5 7.8v5.4M7.8 10.5h5.4"/>',
  grid: '<rect x="3.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="3.5" width="7" height="7" rx="1.5"/><rect x="3.5" y="13.5" width="7" height="7" rx="1.5"/><rect x="13.5" y="13.5" width="7" height="7" rx="1.5"/>',
  sparkles: '<path d="M12 3l1.6 4.4L18 9l-4.4 1.6L12 15l-1.6-4.4L6 9l4.4-1.6L12 3z"/><path d="M18.5 15l.7 1.8 1.8.7-1.8.7-.7 1.8-.7-1.8-1.8-.7 1.8-.7.7-1.8z"/>',
  'arrow-right': '<path d="M4.5 12h15"/><path d="m13.5 6 6 6-6 6"/>',
  'arrow-up': '<path d="M12 20V5"/><path d="m6 11 6-6 6 6"/>',
  'chevron-right': '<path d="m9.5 6 6 6-6 6"/>',
  external: '<path d="M7 17 17 7"/><path d="M8 7h9v9"/>',
  close: '<path d="M6 6l12 12M18 6 6 18"/>',
  bolt: '<path d="M13 2 4.5 13.5H11L10 22l8.5-11.5H12L13 2z"/>',
  chat: '<path d="M20 11.5c0 4.1-3.6 7.5-8 7.5-1 0-2-.2-2.9-.5L4 20l1.5-4.3A7.2 7.2 0 0 1 4 11.5C4 7.4 7.6 4 12 4s8 3.4 8 7.5z"/>',
  gamepad: '<path d="M7.5 7h9a5 5 0 0 1 4.8 3.6l1.2 4.2A2.6 2.6 0 0 1 20 18c-1 0-1.8-.5-2.4-1.4L16 14.5H8l-1.6 2.1C5.8 17.5 5 18 4 18a2.6 2.6 0 0 1-2.5-3.2l1.2-4.2A5 5 0 0 1 7.5 7z"/><path d="M8 10v3M6.5 11.5h3M16 10.5h.01M18 12.5h.01"/>',
  calendar: '<rect x="3.5" y="5" width="17" height="16" rx="2"/><path d="M8 3v4M16 3v4M3.5 10h17"/>',
  book: '<path d="M4 4.5A2.5 2.5 0 0 1 6.5 2H20v18H6.5A2.5 2.5 0 0 0 4 22V4.5z"/><path d="M4 17.5A2.5 2.5 0 0 1 6.5 15H20"/>',
  home: '<path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1V10z"/>',
  check: '<circle cx="12" cy="12" r="9"/><path d="m8 12 2.8 2.8L16 9.5"/>',
  info: '<circle cx="12" cy="12" r="9"/><path d="M12 11v5M12 8h.01"/>',
  filter: '<path d="M3.5 5h17l-6.5 7.5V20l-4-2v-5.5L3.5 5z"/>',
} as const;

type IconName = keyof typeof shapes;
interface Props {
  name: IconName;
  size?: number;
  class?: string;
  strokeWidth?: number;
  /** 提供后图标变为可访问图片；默认作为装饰图标对读屏隐藏 */
  label?: string;
}

const { name, size = 18, class: className = '', strokeWidth = 1.8, label } = Astro.props;
const body = shapes[name];
---

<svg
  class={`icon ${className}`.trim()}
  width={size}
  height={size}
  viewBox="0 0 24 24"
  fill="none"
  stroke="currentColor"
  stroke-width={strokeWidth}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden={label ? undefined : 'true'}
  role={label ? 'img' : undefined}
  aria-label={label}
><Fragment set:html={body} /></svg>
