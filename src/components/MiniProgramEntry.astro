---
// 小程序入口：卡片 + 弹窗二维码
// 配置：name 名称、qr 二维码图片（指向 /images/mp-qr.png）、note 说明
const config = {
  name: '手游测评小程序',
  qr: '/images/mp-qr.svg',
  note: '微信扫一扫，随时随地看测评、查攻略',
};
---

<section class="container">
  <div class="mp-card">
    <img class="qr-thumb" src={config.qr} alt={`${config.name} 二维码`} width="64" height="64" />
    <div class="mp-text">
      <strong>{config.name}</strong>
      <small>{config.note}</small>
    </div>
    <button class="mp-open" id="mp-open" type="button">扫码进入</button>
  </div>
</section>

<div class="modal-mask" id="mp-modal" role="dialog" aria-modal="true" aria-label="小程序二维码">
  <div class="modal">
    <strong>{config.name}</strong>
    <img src={config.qr} alt={`${config.name} 二维码`} width="200" height="200" />
    <div class="close" id="mp-close">关闭</div>
  </div>
</div>

<script>
  const open = document.getElementById('mp-open');
  const modal = document.getElementById('mp-modal');
  const close = document.getElementById('mp-close');
  let lastFocused: HTMLElement | null = null;

  function show() {
    lastFocused = document.activeElement as HTMLElement;
    modal?.classList.add('open');
    close?.focus();
  }
  function hide() {
    modal?.classList.remove('open');
    lastFocused?.focus();
  }

  open?.addEventListener('click', show);
  close?.addEventListener('click', hide);
  modal?.addEventListener('click', (e) => {
    if (e.target === modal) hide();
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal?.classList.contains('open')) hide();
  });
</script>
