---
import GameCard from './GameCard.astro';
import type { Game } from '../data/games';
import { CATEGORY_LIST } from '../data/games';

interface Props {
  games: Game[];
  title?: string;
  badge?: string;
  sub?: string;
  id?: string;
  moreHref?: string;
  moreLabel?: string;
  showTitle?: boolean;
  showFilters?: boolean;
}
const {
  games,
  title = '🎯 全部游戏',
  badge = '',
  sub = '点击卡片查看详情',
  id,
  moreHref,
  moreLabel = '查看全部',
  showTitle = true,
  showFilters = true,
} = Astro.props;
---

<div class="poster-section" data-poster-section>
  {showTitle && (
    <div class="section-title" id={id}>
      <h2>{title}</h2>
      {badge && <span class="badge">{badge}</span>}
      {moreHref
        ? <a class="more" href={moreHref}>{moreLabel} →</a>
        : <span class="sub">{sub}</span>}
    </div>
  )}

  {showFilters && (
    <div class="filter-bar" data-filter-bar>
      <button class="filter-btn active" type="button" data-cat="全部">全部</button>
      {CATEGORY_LIST.map((c) => (
        <button class="filter-btn" type="button" data-cat={c}>{c}</button>
      ))}
      <div class="filter-search">
        <span aria-hidden="true">🔍</span>
        <input type="search" data-search placeholder="搜索游戏 / 标签…" aria-label="搜索游戏或标签" autocomplete="off" />
      </div>
      <span class="result-count" data-count>共 {games.length} 款</span>
    </div>
  )}

  <div class="poster-grid" data-grid>
    {games.map((g) => <GameCard game={g} />)}
    <div class="empty-state" data-empty hidden>😢 没有找到匹配的游戏，换个关键词试试吧～</div>
  </div>

  <!-- 快速预览弹窗 -->
  <div class="modal" data-modal aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-label="游戏快速预览">
      <div class="modal-hero">
        <button class="modal-close" type="button" data-m-close aria-label="关闭">✕</button>
        <img class="modal-hero-img" data-m-img alt="" />
      </div>
      <div class="modal-body">
        <h3 data-m-title></h3>
        <div class="modal-tags" data-m-tags></div>
        <p class="modal-desc" data-m-desc></p>
        <div class="modal-actions">
          <a class="btn-primary" data-m-detail href="#">查看完整测评</a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-poster-section]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-grid]');
    if (!grid) return;
    const cards = Array.from(grid.querySelectorAll<HTMLElement>('.poster-card'));
    const catBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.filter-btn'));
    const search = root.querySelector<HTMLInputElement>('[data-search]');
    const countEl = root.querySelector<HTMLElement>('[data-count]');
    const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
    const modal = root.querySelector<HTMLElement>('[data-modal]');
    let currentCat = '全部';
    let keyword = '';

    // 逐张淡入
    cards.forEach((c, i) => { c.style.animationDelay = `${i * 0.04}s`; });

    function apply() {
      let visible = 0;
      cards.forEach((card) => {
        const d = card.dataset;
        const matchCat = currentCat === '全部' || d.category === currentCat;
        const hay = `${d.title ?? ''} ${d.tags ?? ''} ${d.category ?? ''}`.toLowerCase();
        const matchKw = !keyword || hay.includes(keyword);
        const show = matchCat && matchKw;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (countEl) countEl.textContent = `共 ${visible} 款`;
      if (emptyEl) emptyEl.hidden = visible !== 0;
    }

    // 支持首页分类入口 / 导航栏搜索带来的 ?cat= & ?kw=
    const params = new URLSearchParams(window.location.search);
    const presetCat = params.get('cat');
    const presetKw = params.get('kw');
    if (presetCat) {
      currentCat = presetCat;
      catBtns.forEach((b) => b.classList.toggle('active', b.dataset.cat === presetCat));
    }
    if (presetKw && search) {
      keyword = presetKw.trim().toLowerCase();
      search.value = presetKw;
    }

    catBtns.forEach((btn) => btn.addEventListener('click', () => {
      currentCat = btn.dataset.cat ?? '全部';
      catBtns.forEach((b) => b.classList.toggle('active', b === btn));
      apply();
    }));
    search?.addEventListener('input', () => {
      keyword = (search.value ?? '').trim().toLowerCase();
      apply();
    });
    apply();

    // ── 快速预览弹窗 ──
    const mImg = modal?.querySelector<HTMLImageElement>('[data-m-img]');
    const mTitle = modal?.querySelector<HTMLElement>('[data-m-title]');
    const mTags = modal?.querySelector<HTMLElement>('[data-m-tags]');
    const mDesc = modal?.querySelector<HTMLElement>('[data-m-desc]');
    const mDetail = modal?.querySelector<HTMLAnchorElement>('[data-m-detail]');
    let lastFocus: HTMLElement | null = null;

    function closeModal() {
      if (!modal) return;
      modal.classList.remove('open');
      modal.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      lastFocus?.focus();
    }
    function openModal(d: DOMStringMap) {
      if (!modal) return;
      lastFocus = document.activeElement as HTMLElement | null;
      if (mImg) { mImg.src = d.pCover ?? ''; mImg.alt = `${d.pTitle ?? ''} 官方宣传图`; }
      if (mTitle) mTitle.textContent = d.pTitle ?? '';
      if (mDesc) mDesc.textContent = d.pDesc ?? '';
      if (mTags) {
        const items = [d.pRating ? `★ ${d.pRating}` : '', d.pCat ?? '', ...(d.pTags ?? '').split('、')].filter(Boolean);
        mTags.innerHTML = items.map((t) => `<span>${t}</span>`).join('');
      }
      if (mDetail) mDetail.href = d.pHref ?? '#';
      modal.classList.add('open');
      modal.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
      modal.querySelector<HTMLButtonElement>('[data-m-close]')?.focus();
    }

    root.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((btn) => {
      btn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); openModal(btn.dataset); });
    });
    modal?.querySelector('[data-m-close]')?.addEventListener('click', closeModal);
    modal?.addEventListener('click', (e) => { if (e.target === modal) closeModal(); });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && modal?.classList.contains('open')) closeModal();
    });
  });
</script>
