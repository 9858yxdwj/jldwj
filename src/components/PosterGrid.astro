---
import GameCard from './GameCard.astro';
import Icon from './Icon.astro';
import type { Game } from '../data/games';
import { CATEGORY_LIST } from '../data/games';

interface Props {
  games: Game[];
  title?: string;
  badge?: string;
  sub?: string;
  id?: string;
  moreHref?: string;
  moreLabel?: string;
  showTitle?: boolean;
  showFilters?: boolean;
}
const {
  games,
  title = '🎯 全部游戏',
  badge = '',
  sub = '点击卡片查看详情',
  id,
  moreHref,
  moreLabel = '查看全部',
  showTitle = true,
  showFilters = true,
} = Astro.props;
---

<div class="poster-section" data-poster-section>
  {showTitle && (
    <div class="section-title" id={id}>
      <h2>{title}</h2>
      {badge && <span class="badge">{badge}</span>}
      {moreHref
        ? <a class="more" href={moreHref}>{moreLabel} <Icon name="arrow-right" size={15} /></a>
        : <span class="sub">{sub}</span>}
    </div>
  )}

  {showFilters && (
    <div class="filter-bar" data-filter-bar role="group" aria-label="按分类筛选游戏">
      <button class="filter-btn active" type="button" data-cat="全部" aria-pressed="true">全部</button>
      {CATEGORY_LIST.map((c) => (
        <button class="filter-btn" type="button" data-cat={c} aria-pressed="false">{c}</button>
      ))}
      <div class="filter-search">
        <Icon name="search" size={16} />
        <input type="search" data-search placeholder="搜索游戏 / 标签…" aria-label="搜索游戏或标签" autocomplete="off" />
      </div>
      <span class="result-count" data-count>共 {games.length} 款</span>
    </div>
  )}

  <div class="poster-grid" data-grid>
    {games.map((g) => <GameCard game={g} />)}
    <div class="empty-state" data-empty hidden>😢 没有找到匹配的游戏，换个关键词试试吧～</div>
  </div>

  <!-- 快速预览弹窗 -->
  <div class="modal" data-modal aria-hidden="true">
    <div class="modal-card" role="dialog" aria-modal="true" aria-label="游戏快速预览">
      <div class="modal-hero">
        <button class="modal-close" type="button" data-m-close aria-label="关闭"><Icon name="close" size={18} /></button>
        <img class="modal-hero-img" data-m-img alt="" decoding="async" width="800" height="450" />
      </div>
      <div class="modal-body">
        <h3 data-m-title></h3>
        <div class="modal-tags" data-m-tags></div>
        <p class="modal-desc" data-m-desc></p>
        <div class="modal-actions">
          <a class="btn-primary" data-m-detail href="#">查看完整测评 <Icon name="arrow-right" size={16} /></a>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  // ClientRouter 下 bundle 脚本只执行一次：每次页面替换后重新初始化当前页的海报墙。
  // document 级 keydown 只注册一次并动态查询弹窗；其余监听挂在会被替换的元素上，不会累积。
  const warmed = new Set<string>();
  const lastFocusMap = new WeakMap<HTMLElement, HTMLElement | null>();
  let globalsBound = false;

  function closeModal(modal: HTMLElement) {
    modal.classList.remove('open');
    modal.setAttribute('aria-hidden', 'true');
    document.body.style.overflow = '';
    const prev = lastFocusMap.get(modal);
    if (prev && prev.isConnected) prev.focus();
  }

  function initPosterSections() {
    if (!globalsBound) {
      globalsBound = true;
      document.addEventListener('keydown', (e) => {
        if (e.key !== 'Escape') return;
        document.querySelectorAll<HTMLElement>('[data-modal].open').forEach((m) => closeModal(m));
      });
    }

    document.querySelectorAll<HTMLElement>('[data-poster-section]').forEach((root) => {
      const grid = root.querySelector<HTMLElement>('[data-grid]');
      if (!grid) return;
      const cards = Array.from(grid.querySelectorAll<HTMLElement>('.poster-card'));
      const catBtns = Array.from(root.querySelectorAll<HTMLButtonElement>('.filter-btn'));
      const search = root.querySelector<HTMLInputElement>('[data-search]');
      const countEl = root.querySelector<HTMLElement>('[data-count]');
      const emptyEl = root.querySelector<HTMLElement>('[data-empty]');
      const modal = root.querySelector<HTMLElement>('[data-modal]');

      // 预计算检索文本：避免每次按键都重新拼接字符串并 toLowerCase
      const index = cards.map((el) => ({
        el,
        cat: el.dataset.category ?? '',
        hay: `${el.dataset.title ?? ''} ${el.dataset.tags ?? ''} ${el.dataset.category ?? ''}`.toLowerCase(),
      }));
      // 淡入错峰收敛在 0.14s 内，长列表不再「慢慢冒出来」
      cards.forEach((c, i) => { c.style.animationDelay = `${Math.min(i, 7) * 0.02}s`; });

      let currentCat = '全部';
      let keyword = '';
      function apply() {
        let visible = 0;
        for (const item of index) {
          const show = (currentCat === '全部' || item.cat === currentCat) &&
                       (!keyword || item.hay.includes(keyword));
          // hidden 属性不写内联 style，也不覆盖组件自身的 display 规则
          item.el.hidden = !show;
          if (show) visible++;
        }
        if (countEl) countEl.textContent = `共 ${visible} 款`;
        if (emptyEl) emptyEl.hidden = visible !== 0;
      }
      // 连续输入合并到一帧，避免每个按键都触发一次重排
      let queued = false;
      function scheduleApply() {
        if (queued) return;
        queued = true;
        requestAnimationFrame(() => { queued = false; apply(); });
      }

      // 支持首页分类入口 / 导航栏搜索带来的 ?cat= & ?kw=
      const params = new URLSearchParams(window.location.search);
      const presetCat = params.get('cat');
      const presetKw = params.get('kw');
      if (presetCat) {
        currentCat = presetCat;
        catBtns.forEach((b) => b.classList.toggle('active', b.dataset.cat === presetCat));
      }
      if (presetKw && search) {
        keyword = presetKw.trim().toLowerCase();
        search.value = presetKw;
      }
      // 筛选按钮是切换按钮，同步 aria-pressed 供读屏识别选中态
      catBtns.forEach((b) => b.setAttribute('aria-pressed', String(b.classList.contains('active'))));

      catBtns.forEach((btn) => btn.addEventListener('click', () => {
        currentCat = btn.dataset.cat ?? '全部';
        catBtns.forEach((b) => {
          const on = b === btn;
          b.classList.toggle('active', on);
          b.setAttribute('aria-pressed', String(on));
        });
        apply();
      }));
      search?.addEventListener('input', () => {
        keyword = (search.value ?? '').trim().toLowerCase();
        scheduleApply();
      });
      apply();

      // ── 快速预览弹窗 ──
      const mImg = modal?.querySelector<HTMLImageElement>('[data-m-img]');
      const mTitle = modal?.querySelector<HTMLElement>('[data-m-title]');
      const mTags = modal?.querySelector<HTMLElement>('[data-m-tags]');
      const mDesc = modal?.querySelector<HTMLElement>('[data-m-desc]');
      const mDetail = modal?.querySelector<HTMLAnchorElement>('[data-m-detail]');

      function openModal(d: DOMStringMap) {
        if (!modal) return;
        lastFocusMap.set(modal, document.activeElement as HTMLElement | null);
        if (mImg) { mImg.src = d.pCover ?? ''; mImg.alt = `${d.pTitle ?? ''} 官方宣传图`; }
        if (mTitle) mTitle.textContent = d.pTitle ?? '';
        if (mDesc) mDesc.textContent = d.pDesc ?? '';
        if (mTags) {
          const items = [d.pRating ? `★ ${d.pRating}` : '', d.pCat ?? '', ...(d.pTags ?? '').split('、')].filter(Boolean);
          mTags.replaceChildren(...items.map((t) => {
            const span = document.createElement('span');
            span.textContent = t;
            return span;
          }));
        }
        if (mDetail) mDetail.href = d.pHref ?? '#';
        modal.classList.add('open');
        modal.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
        modal.querySelector<HTMLButtonElement>('[data-m-close]')?.focus();
      }

      // 弹窗大图预热：悬停 / 聚焦时先暖缓存，点击后基本瞬时显示
      function warmCover(btn: HTMLButtonElement) {
        const src = btn.dataset.pCover;
        if (!src || warmed.has(src)) return;
        warmed.add(src);
        const img = new Image();
        img.decoding = 'async';
        img.src = src;
      }
      root.querySelectorAll<HTMLButtonElement>('[data-preview]').forEach((btn) => {
        btn.addEventListener('pointerenter', () => warmCover(btn));
        btn.addEventListener('focus', () => warmCover(btn));
        btn.addEventListener('click', (e) => { e.preventDefault(); e.stopPropagation(); openModal(btn.dataset); });
      });
      modal?.querySelector('[data-m-close]')?.addEventListener('click', () => { if (modal) closeModal(modal); });
      modal?.addEventListener('click', (e) => { if (e.target === modal && modal) closeModal(modal); });
    });
  }

  document.addEventListener('astro:page-load', initPosterSections);
</script>
