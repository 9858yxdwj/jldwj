---
import type { Game } from '../data/games';
import { BADGE_MAP } from '../data/games';

interface Props {
  game: Game;
}
const { game } = Astro.props;

// 评分：null → 「待定」
const ratingText = game.rating === null ? '待定' : game.rating.toFixed(1);
const badgeLabel = game.badge ? BADGE_MAP[game.badge] : '';
const BASE = import.meta.env.BASE_URL;
---

<a class="card" href={`${BASE}games/${game.slug}`} data-category={game.category} data-badge={game.badge} data-title={game.title.toLowerCase()} data-tags={game.tags.join(' ').toLowerCase()}>
  <div class="card-cover">
    <!-- 真实封面建议放 webp/avif 并走 astro:assets 做优化；此处用 public 下 SVG 占位 -->
    <img src={game.cover} alt={`${game.title} 封面`} loading="lazy" decoding="async" width="480" height="270" />
  </div>
  <div class="card-body">
    <div class="card-title-row">
      <h3 class="card-title">{game.title}</h3>
      {badgeLabel && <span class={`badge badge-${game.badge}`}>{badgeLabel}</span>}
    </div>
    <div class="card-meta">
      <span>{game.category}</span>
      <span class="rating">★ {ratingText}</span>
      <span>在玩 {game.players}</span>
    </div>
    <p class="card-desc">{game.description}</p>
    <div class="tags">
      {game.tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</a>
