---
import type { Game } from '../data/games';
import { asset } from '../utils/asset';
import Icon from './Icon.astro';

interface Props {
  game: Game;
}
const { game } = Astro.props;

const BASE = import.meta.env.BASE_URL;
const href = `${BASE}games/${game.slug}`;
const poster = game.poster ?? asset(`/images/posters/${game.slug}.webp`);
const ratingText = game.rating === null ? '待定' : game.rating.toFixed(1);
---

<article
  class="poster-card"
  data-category={game.category}
  data-title={game.title.toLowerCase()}
  data-tags={game.tags.join(' ').toLowerCase()}
>
  <img class="poster-img" src={poster} alt={`${game.title} 竖版海报`} loading="lazy" decoding="async" width="720" height="960" />
  <a class="poster-hit" href={href} aria-label={`查看 ${game.title} 测评详情`}></a>

  <div class="poster-overlay">
    <div class="poster-title">{game.title}</div>
    <div class="poster-desc">{game.description}</div>
    <div class="poster-meta">
      <span class="poster-rating">★ {ratingText}</span>
      <span class="poster-tag">{game.category}</span>
    </div>
    <div class="poster-actions">
      <a class="mini" href={href} data-astro-prefetch="false">查看测评 <Icon name="arrow-right" size={14} /></a>
      <button
        type="button"
        class="mini primary"
        data-preview
        data-p-title={game.title}
        data-p-cover={game.cover}
        data-p-desc={game.description}
        data-p-cat={game.category}
        data-p-rating={ratingText}
        data-p-tags={game.tags.join('、')}
        data-p-href={href}
        aria-label={`快速预览 ${game.title}`}
      ><Icon name="bolt" size={14} /> 快速预览</button>
    </div>
  </div>
</article>
