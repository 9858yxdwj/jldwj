---
import type { CollectionEntry } from 'astro:content';
import { asset } from '../utils/asset';

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { title, summary, cover, category, tags, date } = guide.data;
const BASE = import.meta.env.BASE_URL;
const coverImg = asset(cover ?? '/images/shots/taoyuan-1.webp');
const fmtDate = date.toISOString().slice(0, 10);
const href = `${BASE}guides/${guide.slug}`;
---

<article class="poster-card" data-title={title.toLowerCase()} data-tags={tags.join(' ').toLowerCase()}>
  <span class="poster-ribbon ribbon-pick">攻略</span>
  <img class="poster-img" src={coverImg} alt={`${title} 配图`} loading="lazy" decoding="async" width="960" height="540" />
  <a class="poster-hit" href={href} aria-label={`阅读攻略 ${title}`}></a>
  <div class="poster-overlay">
    <div class="poster-title">{title}</div>
    <div class="poster-desc">{summary}</div>
    <div class="poster-meta">
      <span class="poster-rating">📖 {fmtDate}</span>
      <span class="poster-tag">{category}</span>
    </div>
    <div class="poster-actions">
      <a class="mini primary" href={href}>阅读全文 →</a>
    </div>
  </div>
</article>
