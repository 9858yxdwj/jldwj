---
import type { CollectionEntry } from 'astro:content';
import { asset } from '../utils/asset';

interface Props {
  guide: CollectionEntry<'guides'>;
}
const { guide } = Astro.props;
const { title, summary, cover, category, tags, date } = guide.data;
const BASE = import.meta.env.BASE_URL;
const coverImg = asset(cover ?? '/images/shots/taoyuan-1.webp');
const fmtDate = date.toISOString().slice(0, 10);
---

<a class="card" href={`${BASE}guides/${guide.slug}`} data-title={title.toLowerCase()} data-tags={tags.join(' ').toLowerCase()}>
  <div class="card-cover">
    <img src={coverImg} alt={`${title} 配图`} loading="lazy" decoding="async" width="960" height="540" />
  </div>
  <div class="card-body">
    <div class="card-title-row">
      <h3 class="card-title">{title}</h3>
      <span class="badge">{category}</span>
    </div>
    <p class="card-desc">{summary}</p>
    <div class="card-meta">
      <span>{fmtDate}</span>
    </div>
    <div class="tags">
      {tags.map((t) => <span class="tag">{t}</span>)}
    </div>
  </div>
</a>
