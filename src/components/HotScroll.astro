---
import { games } from '../data/games';
import { asset } from '../utils/asset';

const BASE = import.meta.env.BASE_URL;
// 主推 + 热门，最多 6 款，横向滚动展示
const hot = games.filter((g) => g.badge === 'pick' || g.badge === 'hot').slice(0, 6);
---

<div class="section-title" id="hot">
  <h2>🔥 热门推荐</h2>
  <span class="badge">HOT</span>
  <span class="sub">本期主推与高人气收录 · 横向滑动查看更多</span>
</div>

<div class="hot-scroll">
  {hot.map((g) => (
    <a class="hot-card" href={`${BASE}games/${g.slug}`} aria-label={`查看 ${g.title} 测评`}>
      <img
        class="poster-img"
        src={g.poster ?? asset(`/images/posters/${g.slug}.webp`)}
        alt={`${g.title} 竖版海报`}
        loading="lazy" decoding="async" fetchpriority="low" width="600" height="800"
      />
      <div class="poster-overlay">
        <div class="poster-title">{g.title}</div>
        <div class="poster-meta">
          <span class="poster-rating">★ 待定</span>
          <span class="poster-tag">{g.category}</span>
        </div>
      </div>
    </a>
  ))}
</div>
