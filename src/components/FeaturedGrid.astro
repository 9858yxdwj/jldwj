---
import GameCard from './GameCard.astro';
import { games } from '../data/games';

interface Props {
  /** 最多取几款，默认 3 */
  limit?: number;
}
const { limit = 3 } = Astro.props;

// 主推游戏已由 FeaturedSpotlight 单独大图展示，这里展示其余收录游戏
const featured = games.filter((g) => g.badge !== 'pick').slice(0, limit);
const BASE = import.meta.env.BASE_URL;
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>更多收录</h2>
      <a href={`${BASE}library`}>查看全部 →</a>
    </div>
    <div class="grid">
      {featured.map((g) => <GameCard game={g} />)}
    </div>
  </div>
</section>
