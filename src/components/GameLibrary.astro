---
import GameCard from './GameCard.astro';
import { games, CATEGORY_LIST, BADGE_MAP } from '../data/games';

const badgeOptions = ['pick', 'new', 'hot'];
---

<section class="section">
  <div class="container">
    <div class="section-head">
      <h2>游戏库</h2>
    </div>

    <!-- 筛选条：纯前端 JS，按 data-* 属性过滤 -->
    <div class="filter-bar" id="filter-bar">
      <select id="f-category" aria-label="按分类筛选">
        <option value="">全部分类</option>
        {CATEGORY_LIST.map((c) => <option value={c}>{c}</option>)}
      </select>
      <select id="f-badge" aria-label="按角标筛选">
        <option value="">全部角标</option>
        {badgeOptions.map((b) => <option value={b}>{BADGE_MAP[b]}</option>)}
      </select>
      <input id="f-keyword" type="search" placeholder="搜索游戏名 / 标签…" aria-label="关键词搜索" />
    </div>

    <div class="grid" id="game-grid">
      {games.map((g) => <GameCard game={g} />)}
    </div>
    <p id="empty-tip" style="display:none;color:var(--c-text-muted);padding:var(--sp-5) 0;">
      没有匹配的游戏，换个筛选条件试试。
    </p>
  </div>
</section>

<script>
  const grid = document.getElementById('game-grid') as HTMLElement | null;
  const cat = document.getElementById('f-category') as HTMLSelectElement | null;
  const badge = document.getElementById('f-badge') as HTMLSelectElement | null;
  const kw = document.getElementById('f-keyword') as HTMLInputElement | null;
  const emptyTip = document.getElementById('empty-tip');

  function applyFilter() {
    if (!grid) return;
    const c = cat?.value ?? '';
    const b = badge?.value ?? '';
    const k = (kw?.value ?? '').trim().toLowerCase();
    let visible = 0;
    grid.querySelectorAll<HTMLElement>('.card').forEach((el) => {
      const matchCat = !c || el.dataset.category === c;
      const matchBadge = !b || el.dataset.badge === b;
      const hay = `${el.dataset.title ?? ''} ${(el.dataset.tags ?? '')}`.toLowerCase();
      const matchKw = !k || hay.includes(k);
      const show = matchCat && matchBadge && matchKw;
      el.style.display = show ? '' : 'none';
      if (show) visible++;
    });
    if (emptyTip) emptyTip.style.display = visible === 0 ? 'block' : 'none';
  }

  [cat, badge, kw].forEach((el) => el?.addEventListener('input', applyFilter));
  [cat, badge].forEach((el) => el?.addEventListener('change', applyFilter));
</script>
